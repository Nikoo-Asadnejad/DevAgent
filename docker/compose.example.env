# Copy to docker/.env (git-ignored) and fill in. Every value here is a secret unless noted.

# --- platform ---
DEVAGENT_DOMAIN=agent.example.com            # public hostname for the API (not secret)
DEVAGENT_WORKSPACES=/var/lib/devagent/workspaces   # host dir for per-run clones (not secret)
DEVAGENT_ADMIN_TOKEN=change-me-long-random   # bearer token for /issues and /runs endpoints

# --- GitHub issues, repositories, branches and pull requests ---
GITHUB_TOKEN=

# --- Codex subscription login ---
# Run `codex login` on a machine with a browser, then paste the contents of ~/.codex/auth.json (one line).
CODEX_AUTH_JSON=
